# Leave empty in development: Vite proxies /api to VITE_API_PROXY_TARGET (default http://localhost:5000).
# Set it for a built bundle that talks to the API on another origin, e.g. https://api.example.com
VITE_API_BASE_URL=

# Dev-server proxy target for /api (used by npm run dev only)
VITE_API_PROXY_TARGET=http://localhost:5000
