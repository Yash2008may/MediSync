# ---------- Server ----------
NODE_ENV=development
PORT=5000
# Exact browser origins allowed by CORS. Preview hosts (*.style.dev) and loopback ports are
# matched automatically while ALLOW_PREVIEW_ORIGINS=true, so a restored workspace needs no edit.
CLIENT_ORIGIN=http://localhost:5173
ALLOW_PREVIEW_ORIGINS=true

# ---------- PostgreSQL (13+) ----------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/medisync
DATABASE_SSL=false

# ---------- Auth ----------
# Generate:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string_at_least_32_chars
JWT_EXPIRES_IN=7d
# Browser sessions use an httpOnly cookie. Bearer tokens still work for scripts/API tests.
SESSION_COOKIE_DAYS=7
# Set true only when the app is embedded as a cross-site iframe (an agent preview panel);
# it makes the session cookie Secure + SameSite=None + Partitioned. Leave false when hosted normally.
COOKIE_PARTITIONED=false
BCRYPT_ROUNDS=12

# ---------- Pharmacy licence verification ----------
# true  = new pharmacies are approved instantly (LOCAL TESTING ONLY; the server refuses to
#         start with this on when NODE_ENV=production)
# false = pharmacies stay "pending" until an admin approves them
AUTO_VERIFY_PHARMACIES=true

# ---------- Forgot-password OTP ----------
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
# Per-account cap on OTPs sent in any rolling hour (abuse protection).
OTP_MAX_PER_HOUR=5
DEV_LOG_OTP=true

# ---------- Rate limits (requests per 15 min / per min) ----------
RATE_LIMIT_API=900
RATE_LIMIT_WRITE=120
RATE_LIMIT_AUTH=20

# ---------- Google Maps (server key: restrict by IP; enable "Places API (New)" + "Geocoding API") ----------
GOOGLE_MAPS_SERVER_KEY=
# Optional browser key for the live map on the patient Pharmacies page (restrict by HTTP referrer).
# Without it the page draws a schematic plot of the same real coordinates.
GOOGLE_MAPS_BROWSER_KEY=
# Typed place names ("default location") resolve without a Google key: first the built-in
# locality index, then OpenStreetMap Nominatim. Nominatim is free and keyless but asks for
# at most one request per second, so set GOOGLE_MAPS_SERVER_KEY for production traffic.
GEOCODER_NOMINATIM=true
GEOCODER_USER_AGENT=MediSync/1.0 (demo pharmacy app)
NEARBY_RADIUS_METERS=5000
# Reject live locations less precise than this (IP-based fixes are often km off)
GEO_MAX_ACCURACY_METERS=2000

# ---------- Prescriptions ----------
UPLOAD_DIR=./uploads
# Used when the pharmacist does not set an expiry on approval
PRESCRIPTION_DEFAULT_VALID_DAYS=30
# Prescription files are encrypted at rest (AES-256-GCM). Set a dedicated 64-hex-char key to
# separate file encryption from the JWT secret; when empty it is derived from JWT_SECRET.
# Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FILE_ENCRYPTION_KEY=
# Health-data retention: prescription files of finished orders are deleted after N days.
PRESCRIPTION_RETENTION_DAYS=180
NOTIFICATION_RETENTION_DAYS=90
# Daily cleanup inside the web process (set to "off" to disable).
RETENTION_CRON=0 3 * * *

# ---------- Orders ----------
ORDER_MAX_LINES=20
ORDER_PAGE_SIZE=25

# ---------- Email (Nodemailer / SMTP) ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="MediSync <no-reply@medisync.local>"

# ---------- SMS: console | fast2sms | twilio ----------
# India: transactional SMS needs DLT registration (entity, sender ID, templates) with your provider.
SMS_PROVIDER=console
DEFAULT_COUNTRY_CODE=+91
FAST2SMS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ---------- Production hosting ----------
# Serve the built client (client/dist) from this API (default: true when NODE_ENV=production)
SERVE_CLIENT=false
