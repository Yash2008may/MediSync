{
  "name": "medisync-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "MediSync backend \u2013 Node.js + Express + PostgreSQL",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:migrate": "node db/migrate.js",
    "db:reset": "node db/reset.js",
    "db:seed": "node db/seed.js",
    "db:setup": "npm run db:reset && npm run db:seed",
    "db:retention": "node db/retention.js",
    "db:backup": "bash scripts/backup.sh",
    "admin:create": "node db/create-admin.js",
    "test": "node --import ./test/env-setup.js --test --test-concurrency=1 test/unit test/integration",
    "test:unit": "node --test test/unit"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.16",
    "pg": "^8.13.1",
    "twilio": "^5.4.0",
    "zod": "^3.24.1"
  }
}
